# ============================================================================
# NZB-Sport-Pro configuration. Copy this file to `.env` and fill in.
# Users configure their own TorBox and Newznab credentials on the public page.
# ============================================================================

# ---- Server ----------------------------------------------------------------
PORT=7000
# Public origin the addon is reached at, used to build install URLs. Leave blank
# to auto-detect from the request (honours X-Forwarded-Proto/Host from a reverse
# proxy / Cloudflare tunnel). Set it if auto-detect gets the scheme/host wrong.
# PUBLIC_URL=https://sports.example.com

# ---- Private manifests / operator auth ------------------------------------
# Public users do not create accounts. SESSION_SECRET encrypts and authenticates
# the private configuration embedded in each generated manifest URL, and signs
# optional operator login cookies. Changing it invalidates existing manifests.
# It is REQUIRED to be >=32 chars in production. Generate with:
#   openssl rand -hex 32
# Dev-only escape hatch: set ALLOW_INSECURE_SECRET=1 to allow a missing/short
# secret. Never use that in production — it lets sessions be forged across any
# default-config instance.
SESSION_SECRET=
# ALLOW_INSECURE_SECRET=1

# Optional operator account. Visit /setup explicitly to create it; public users
# always use the stateless /configure page.
ADMIN_USER=

# Login rate-limit (0.22.2). After LOGIN_MAX_FAILS failed sign-ins from the
# same IP within LOGIN_WINDOW_MS, that IP is locked out for LOGIN_LOCKOUT_MS.
# Successful login resets the counter. Defaults: 5 fails / 15 min / 15 min.
# LOGIN_MAX_FAILS=5
# LOGIN_WINDOW_MS=900000
# LOGIN_LOCKOUT_MS=900000

# Per-play /resolve URL signature TTL (0.25.0). Each row's resolve URL
# carries ?exp=&sig= and is rejected after this many minutes. The install
# URL itself stays stable — only the short play-click URLs rotate. Default
# 240 (4 hours). Minimum enforced: 5 minutes.
# RESOLVE_URL_TTL_MINUTES=240

# ---- Stremio presentation --------------------------------------------------
# 'movie' renders events as movies in Discover. Some clients (Nuvio Mobile/TV)
# handle 'tv'/'series' better — switch if yours doesn't render properly.
ADDON_TYPE=movie

# ---- Metadata window (TheSportsDB) -----------------------------------------
# Free public key is "3"; a Patreon key gives much better rate limits.
# https://www.thesportsdb.com/free_sports_api
TSDB_API_KEY=123
# Seasons to pull. 'auto' derives years from the event window below so we don't
# Optional metadata sources for custom promotions:
# - football-data.org competition code + API key
# - TMDB TV show id + API key for dated sports programmes
# Keys can also be saved in the admin UI where supported.
FOOTBALL_DATA_API_KEY=
TMDB_API_KEY=

# hammer TSDB's rate limit. Or force a comma list, e.g. 2024,2025,2026.
TSDB_SEASONS=auto
# Sliding window of events kept in the metadata cache (days back / ahead). The
# future side is wide so promotions that announce months ahead still appear in
# Upcoming. EVENT_WINDOW_START_DATE (e.g. 2025-01-01) hard-floors the start.
EVENT_WINDOW_DAYS_BACK=30
EVENT_WINDOW_DAYS_AHEAD=90
# EVENT_WINDOW_START_DATE=2025-01-01
# Optional override for Content Studio's refresh-safe editorial state.
# CONTENT_STUDIO_FILE=./data/content-studio.json
# Metadata refresh cadence in hours (0 disables the scheduler).
REFRESH_INTERVAL_HOURS=6

# Optional artwork enrichment only. When enabled, UFC/ONE events that lack
# source artwork may receive a poster from their Wikipedia page. Wikipedia is
# never used for stream discovery. Set "off" for faster metadata refreshes;
# branded fallback artwork remains available.
WIKIPEDIA_ENRICH=on

# ---- Optional playback pipelines ------------------------------------------
# Metadata/catalogs work without any of these.
#
# Pipeline A: torrent discovery -> per-user TorBox
#
# Recommended: the bundled _scraper service can combine Prowlarr, Zilean,
# Knaben, Torznab, TheRARBG, Bitsearch, and other sources.
COMPANION_URL=
COMPANION_AUTH_TOKEN=
# COMPANION_TIMEOUT_MS=20000
#
# Optional direct Prowlarr alternative/supplement. Direct Prowlarr and the
# companion are searched only when a user opens an event.
# These can also be saved in Admin -> Torrent discovery and metadata sources,
# which overrides env values.
PROWLARR_URL=
PROWLARR_API_KEY=
#
# TORBOX_API_BASE=https://api.torbox.app/v1/api

# User TorBox and Newznab credentials are intentionally absent from this file
# and are encrypted into each private manifest configuration.
# Public-host safety defaults: HTTPS + public addresses + same-host NZB links.
# These local-development overrides must stay off on a public deployment.
# NATIVE_NEWZNAB_ALLOW_PRIVATE=on
# NATIVE_NEWZNAB_ALLOW_HTTP=on
# NATIVE_NEWZNAB_MAX_SEARCH_BYTES=3145728
# NATIVE_NEWZNAB_MAX_NZB_BYTES=10485760
# NATIVE_NEWZNAB_MAX_QUERIES=4
# NATIVE_NEWZNAB_CANDIDATE_TTL_MINUTES=240
# Displayed NZBs fetched into bounded memory during stream discovery so every
# native row can be classified against TorBox's shared Usenet cache. Defaults
# to STREAM_MAX_ROWS and cannot exceed it.
# NATIVE_NEWZNAB_PREPARE_MAX=20
# NATIVE_NEWZNAB_PREPARE_CONCURRENCY=4
# NATIVE_NEWZNAB_PREPARED_TTL_MINUTES=30
# NATIVE_NEWZNAB_PREPARED_MAX_BYTES=67108864
# TORBOX_USENET_CREATE_TIMEOUT_MS=20000
# How long each clicked Usenet resolver request waits for TorBox to expose a
# playable file before continuing through another signed resolver redirect.
# Default 35000; range 0-45000 ms.
# TORBOX_USENET_PLAY_WAIT_MS=35000
# Maximum automatic continuation redirects while the same TorBox job processes.
# Default 5; range 0-15. The conservative default leaves redirect headroom for
# native players and the final TorBox/CDN hand-off. Set to 0 to return the
# processing response immediately.
# TORBOX_USENET_WAIT_REDIRECTS=5

# Optional admin power-tool keys. These are not user playback credentials.
# They let the administrator verify and warm selected hashes for one event.
# ADMIN_TB_TOKEN=
# ADMIN_PM_KEY=

# ---- Stream request tuning -------------------------------------------------
STREAM_MAX_ROWS=20
STREAM_PIPELINE_TIMEOUT_MS=8000
WARM_MAX_ROWS=5
WARM_RATE_LIMIT_COUNT=5
WARM_RATE_LIMIT_WINDOW_SEC=3600
# Set to 1 temporarily when debugging relevance false-negatives.
# LOG_EXCLUDED_TITLES=0
# Set to 1 to retain foreign-language releases in candidate filtering.
# ALLOW_FOREIGN_LANG=0

# ---- Outbound proxy (optional) ---------------------------------------------
# Applies to outbound metadata, Newznab, Easynews, and companion calls from
# this container. The scraper has its own proxy settings in _scraper/.env.
# HTTPS_PROXY=http://gluetun:8888
# HTTP_PROXY=http://gluetun:8888
# NO_PROXY=localhost,127.0.0.1,serioussportsync-scraper
