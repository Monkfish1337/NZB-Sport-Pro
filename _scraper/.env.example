# SeriousSportSync Scraper — env example.
# Copy to .env (or set in your docker-compose `environment:` block) and tune.

# Bind address + port for the HTTP server + GUI.
HOST=0.0.0.0
PORT=8080

# Optional shared bearer token required on /scrape calls. Leave blank to
# leave the endpoint open. When set, the metadata addon must send
# `Authorization: Bearer <token>`. Match COMPANION_AUTH_TOKEN on the addon
# side.
SCRAPER_AUTH_TOKEN=

# Default per-source timeout (ms). Individual sources can override this
# via their own config.
SOURCE_TIMEOUT_MS=10000

# Hard ceiling on overall /scrape response time. Slow sources beyond this
# contribute nothing.
SCRAPE_BUDGET_MS=25000

# In-memory log ring buffer size (lines).
LOG_BUFFER_MAX=4000

# How many /scrape calls to retain on disk for the History page.
HISTORY_MAX=200

# Outbound HTTP proxy (e.g. http://gluetun:8888). Leave blank for direct.
# NO_PROXY = comma-separated hosts that bypass the proxy.
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,prowlarr,zilean

# Where on-disk state lives. Default fine for Docker (volume mount target).
DATA_DIR=./data
