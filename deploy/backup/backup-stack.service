[Unit]
Description=stremio-stack daily backup
Documentation=file:///mnt/storage/stremio-stack/scripts/backup-stack.sh
Wants=backup-stack.timer
After=network-online.target
Requires=network-online.target

[Service]
Type=oneshot
ExecStart=/mnt/storage/stremio-stack/scripts/backup-stack.sh
User=root
Group=root
StandardOutput=journal
StandardError=journal
# 20 min max — actual runs in <1 min, cap prevents runaway
TimeoutStartSec=1200
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
