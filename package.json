{
    "name":  "serioussportsync",
    "version": "0.42.14",
    "description":  "Self-hosted Stremio addon: sports metadata catalog. Delegates content discovery to a separately-deployed companion scraper and resolves results through the user's own TorBox key. Covers UFC, ONE Championship, WWE, AEW, F1, Boxing, MotoGP.",
    "main":  "server.js",
    "scripts":  {
                    "start":  "node server.js",
                    "refresh":  "node scripts/refresh.js",
                    "refresh-streams":  "node scripts/refresh-streams.js",
                    "gen-token":  "node scripts/gen-token.js",
                    "dev":  "node server.js"
                },
    "keywords":  [
                     "stremio",
                     "stremio-addon",
                     "sports",
                     "ufc",
                     "mma",
                     "wwe",
                     "aew",
                     "real-debrid",
                     "torbox",
                     "premiumize",
                     "prowlarr",
                     "metadata"
                 ],
    "license":  "MIT",
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "express":  "^4.19.2",
                         "node-fetch":  "^2.7.0",
                         "https-proxy-agent":  "^7.0.2"
                     },
    "engines":  {
                    "node":  "\u003e=18"
                }
}
