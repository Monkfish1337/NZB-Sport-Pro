{
    "name": "nzb-sport-pro",
    "version": "0.4.2",
    "description": "Public-ready sports metadata addon with private per-user Newznab discovery and TorBox Usenet playback.",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "refresh": "node scripts/refresh.js",
        "gen-token": "node scripts/gen-token.js",
        "dev": "node server.js",
        "test:uu": "node scripts/test-uu-direct-search.js",
        "test:nuvio": "node scripts/test-nuvio-collections.js",
        "test:manutd": "node scripts/test-man-united.js",
        "test:prowlarr": "node scripts/test-prowlarr-hydration.js",
        "test:torbox-voyager": "node scripts/test-torbox-voyager.js",
        "test:native-newznab": "node scripts/test-native-newznab.js && node scripts/test-torbox-usenet.js && node scripts/test-newznab-encryption.js && node scripts/test-request-guard.js",
        "test:public-page": "node scripts/test-public-page.js && node scripts/test-setup-security.js && node scripts/test-redaction.js",
        "sync:metadata": "node scripts/sync-metadata.js"
    },
    "keywords": [
        "stremio",
        "stremio-addon",
        "sports",
        "ufc",
        "mma",
        "wwe",
        "aew",
        "torbox",
        "prowlarr",
        "usenet",
        "easynews",
        "metadata"
    ],
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "express": "^4.22.2",
        "https-proxy-agent": "^7.0.2",
        "node-fetch": "^2.7.0"
    },
    "engines": {
        "node": ">=24"
    }
}
